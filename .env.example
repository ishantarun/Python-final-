# Daywise Application Environment Configuration Example
# Copy this file to .env and configure values for your environment

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# Default: Local SQLite database
DATABASE_URL=sqlite:///./daywise.db
# For PostgreSQL deployment, use:
# DATABASE_URL=postgresql://username:password@localhost:5432/daywise_db

# Application URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Email (SMTP) Configuration for Reminders, Verification & Password Resets
# Leave empty or blank to run in simulation/log mode (in-app notifications will still function)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-secure-smtp-password
SMTP_FROM_EMAIL=no-reply@daywise.app
SMTP_FROM_NAME=Daywise To-Do
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# App Settings
ENVIRONMENT=development
ENABLE_BACKGROUND_SCHEDULER=true
